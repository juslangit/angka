{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "angka",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "ai": { "binding": "AI" },
  // per visitor: 30 model calls a minute (each question is about 3)
  "ratelimits": [{ "name": "LIMITER", "namespace_id": "4271", "simple": { "limit": 30, "period": 60 } }],
  "observability": { "enabled": true }
}
